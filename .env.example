# Ticket Booking System — environment configuration
#
# Copy this file to `.env` at the repo root and fill in every value with no default below.
# `.env` is gitignored — never commit it.
#
# Every variable here is validated by server/src/config/env.js at boot, with Zod. A missing or
# invalid required variable crashes the server immediately with a readable error — that's
# deliberate (see CLAUDE.md: "Fail fast and loudly on a missing variable — never start
# half-configured"). If you change a value's shape here, update env.js's schema in the same
# commit; they must never drift apart.

# --- Runtime ---------------------------------------------------------------

# development | test | production. Controls nothing else directly yet, but later phases (Ethereal
# vs. real SMTP, verbose logging) branch on it. Defaults to development if unset.
NODE_ENV=development

# Port the Express server listens on. Defaults to 3000 if unset.
PORT=3000

# The API's own public base URL. Used to build absolute links (email templates, QR check-in
# URLs) that must resolve correctly from outside your machine, not just from localhost.
API_URL=http://localhost:3000

# The client's origin. Since D-53, client/index.html is served BY this same Express process at
# `/` — there is no separate client dev server, so this should normally equal http://localhost:PORT.
# Still read by CORS (credentialed requests need an explicit origin, not `*`) and by mail templates
# building absolute links (the waitlist claim URL) — get it wrong and browser API calls fail with a
# CORS error, not an auth error, which is a confusing thing to debug blind.
WEB_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------

# Postgres connection string. No default — the server refuses to boot without one, because a
# fallback here could silently point at the wrong database. See docs/DEPLOYMENT.md for how
# `ticket_booking` and `ticket_booking_test` get created.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/ticket_booking

# Max connections in this process's pg.Pool. Kept at 10, not higher, deliberately — each
# connection costs real memory on the target 4GB dev machine. See docs/DEPLOYMENT.md's
# postgresql.conf section for how this relates to Postgres's own max_connections=50.
PGPOOL_MAX=10

# --- Background jobs -----------------------------------------------------------

# How often the job_queue poller checks for due work, in milliseconds. Lower means a hold or
# offer is released closer to the instant its TTL expires, at the cost of more idle-poll queries.
JOB_POLL_INTERVAL_MS=2000

# A job is retried with backoff up to this many times before being marked DEAD and surfaced at
# GET /health. Too low and a transient failure (a brief DB blip) permanently strands a job; too
# high delays noticing a job that's actually broken.
JOB_MAX_ATTEMPTS=5

# --- Auth ----------------------------------------------------------------------

# HMAC signing secrets for access and refresh JWTs. No defaults, ever — a checked-in default
# secret would mean every deployment of this codebase trusts the same key. Generate real ones,
# e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be at least 32 characters, and must differ from QR_SIGNING_SECRET below.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# How long an access/refresh token stays valid, as a jsonwebtoken duration string (e.g. "15m",
# "7d"). A shorter JWT_ACCESS_TTL limits the damage window of a stolen access token; a longer
# JWT_REFRESH_TTL means a user stays logged in longer between password re-entries.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- QR / ticketing --------------------------------------------------------------

# Signs the QR check-in JWT. Deliberately a SEPARATE secret from the auth secrets above (see
# Decisions Ledger D-10) — env.js refuses to boot if this matches either JWT secret, so a
# copy-paste mistake here fails loudly instead of quietly weakening that isolation.
QR_SIGNING_SECRET=

# --- Seat holds and waitlist offers -----------------------------------------------

# Default seat-hold TTL in seconds, used when a show doesn't set its own hold_ttl_seconds. This
# is the number that makes "release seats nobody is actually buying" visible in a demo — too
# long and a stuck browser tab locks a seat for ages; too short and real checkouts start timing
# out.
SEAT_HOLD_TTL_SECONDS=600

# How long a waitlist offer stays claimable before it cascades to the next person in line.
WAITLIST_OFFER_TTL_SECONDS=900

# How many people in the waitlist queue get offered the same freed seat(s) before giving up and
# releasing them to the public pool. Also defines show_seats.reserved_until (Decisions Ledger
# D-14) — raising this lengthens how long a seat can stay off the public market by design, it is
# not just a retry count.
WAITLIST_MAX_CASCADE_ATTEMPTS=5

# --- Scheduled jobs (node-cron syntax) --------------------------------------------

# How often the Layer-3 hold reconciler sweeps for expired holds the job queue might have
# missed. This is the safety net under the safety net (docs/PROJECT_PROMPT.md §5.2) — it runs
# whether or not the job poller is alive.
HOLD_RECONCILER_CRON=*/30 * * * * *

# How often the outbox reconciler sweeps for email rows whose job_queue row was lost.
OUTBOX_RECONCILER_CRON=*/60 * * * * *

# --- Booking rules ---------------------------------------------------------------

# Hard cap on seats per single booking. Enforced at the API layer, not just in the UI.
MAX_SEATS_PER_BOOKING=6

# Booking fee as a percentage of subtotal, added on top at checkout. 0 means no fee.
BOOKING_FEE_PERCENT=0

# --- Email (Nodemailer) -----------------------------------------------------------

# Leave every SMTP_* var and MAIL_FROM blank in development: server/src/mail/mailer.js (P4-7)
# detects an empty SMTP_HOST and auto-creates a throwaway Ethereal test account instead, with a
# preview URL logged to the console — nothing to install, nothing to configure. Fill these in
# only for a real deployment with a real SMTP provider (Brevo, Resend, etc.).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Rate limiting -----------------------------------------------------------------

# Max POST /holds requests per user per minute, enforced by express-rate-limit (P9-1). Guards
# against a buggy or malicious client hammering the atomic-acquire query.
RATE_LIMIT_HOLD_PER_MIN=10

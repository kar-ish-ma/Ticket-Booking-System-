{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": false,
    "noEmit": true
  },
  "include": ["server/src/**/*.js", "shared/**/*.js", "client/src/**/*.js"],
  "exclude": ["**/node_modules/**", "**/dist/**", "**/coverage/**"]
}
